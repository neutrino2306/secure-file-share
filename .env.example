# Copy this file to .env and replace every placeholder value.
# Never commit .env to git.

# HMAC signing secret for download links (at least 32 characters).
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it stable: changing it invalidates every link issued so far.
SIGNING_SECRET=CHANGE_ME

# Comma-separated "api_key:user_id" pairs. Each key must be at least 16 characters.
# Generate a key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=replace-me-alice-api-key:alice,replace-me-bob-api-key-000:bob

# Base URL used to build signed links (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8000

# Private directory for uploaded files and the SQLite database.
DATA_DIR=./data

# Maximum upload size in bytes (default: 50 MiB).
MAX_UPLOAD_BYTES=52428800

# Allowed TTL range for signed links, in seconds (default: 60 seconds to 7 days).
MIN_TTL_SECONDS=60
MAX_TTL_SECONDS=604800

# Host port published by docker compose (use 80 on a server).
# HOST_PORT=8000
